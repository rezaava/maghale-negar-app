<UserControl
        x:Class="MaghaleNegar.Forms.MaghaleNegarManager.CreateDocument.CreateDocumentSlide6"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DesignHeight="850"
        d:DesignWidth="800"
        FlowDirection="RightToLeft"
        FontFamily="Vazirmatn"
        mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MaghaleNegar;component/Forms/Styles/MainDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SectionSeparator" TargetType="Separator">
                <Setter Property="Height" Value="2"/>
                <Setter Property="Margin" Value="0,10,0,15"/>
                <Setter Property="Background" Value="{StaticResource PrimaryBackgroundColor}"/>
                <Setter Property="Opacity" Value="0.3"/>
            </Style>

            <Style x:Key="PreviewBox" TargetType="Border">
                <Setter Property="Background" Value="#F8F9FA"/>
                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="15,12"/>
                <Setter Property="Margin" Value="5,0,5,15"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="White" CornerRadius="0,0,10,10">
        <Grid x:Name="gridMain">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer
                    x:Name="scrollContent"
                    Grid.Row="0"
                    Margin="0,10,0,0"
                    VerticalScrollBarVisibility="Auto">

                <StackPanel
                        x:Name="stackContent"
                        Margin="20,0,20,20"
                        Orientation="Vertical">

                    <!-- ========================================== -->
                    <!-- بخش ۱: نویسنده -->
                    <!-- ========================================== -->

                    <TextBlock 
                            Text="✍️ نویسنده"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryBackgroundColor}"
                            Margin="5,0,5,10" />

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                                x:Name="cmbNameList"
                                Grid.Column="0"
                                Margin="5"
                                materialDesign:HintAssist.Background="{StaticResource LightBackgroundColor}"
                                materialDesign:HintAssist.FloatingScale="1"
                                materialDesign:HintAssist.Hint="انتخاب نام نویسنده"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                SelectionChanged="CmbNameList_SelectionChanged" />
                    </Grid>

                    <Separator Style="{StaticResource SectionSeparator}" />

                    <!-- ========================================== -->
                    <!-- بخش ۲: نوع دانشگاه -->
                    <!-- ========================================== -->

                    <TextBlock 
                            Text="📌 نوع دانشگاه"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryBackgroundColor}"
                            Margin="5,0,5,10" />

                    <Border 
                            Background="#F5F5F5" 
                            CornerRadius="6" 
                            Padding="12,10"
                            Margin="5,0,5,15">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox 
                                    x:Name="chkAzad" 
                                    Content="دانشگاه آزاد"
                                    FontSize="14"
                                    Margin="0,0,25,0"
                                    Checked="ChkUniversityType_Checked"
                                    Unchecked="ChkUniversityType_Unchecked" />

                            <CheckBox 
                                    x:Name="chkDolati" 
                                    Content="دانشگاه دولتی"
                                    FontSize="14"
                                    Checked="ChkUniversityType_Checked"
                                    Unchecked="ChkUniversityType_Unchecked" />
                        </StackPanel>
                    </Border>

                    <Separator Style="{StaticResource SectionSeparator}" />

                    <!-- ========================================== -->
                    <!-- بخش ۳: اطلاعات دانشگاهی -->
                    <!-- ========================================== -->

                    <TextBlock 
                            Text="🏛️ اطلاعات دانشگاهی"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryBackgroundColor}"
                            Margin="5,0,5,10" />

                    <!-- مقطع تحصیلی -->
                    <TextBlock 
                            Text="مقطع تحصیلی یا مرتبه علمی:"
                            FontSize="13"
                            Foreground="#555555"
                            Margin="5,0,5,3" />

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                                x:Name="txtAcademicDegreeFa"
                                Grid.Column="0"
                                Margin="5"
                                materialDesign:HintAssist.Background="{StaticResource LightBackgroundColor}"
                                materialDesign:HintAssist.FloatingScale="1"
                                materialDesign:HintAssist.Hint="فارسی"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Tag="Persian"
                                TextWrapping="Wrap"
                                LostFocus="AnyTextBox_LostFocus" />
                        <TextBox
                                x:Name="txtAcademicDegreeEn"
                                Grid.Column="1"
                                Margin="5"
                                materialDesign:HintAssist.Background="{StaticResource LightBackgroundColor}"
                                materialDesign:HintAssist.FloatingScale="1"
                                materialDesign:HintAssist.Hint="English"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Tag="English"
                                TextWrapping="Wrap" 
                                LostFocus="AnyTextBox_LostFocus" />
                    </Grid>

                    <!-- نام گروه -->
                    <TextBlock 
                            Text="نام گروه:"
                            FontSize="13"
                            Foreground="#555555"
                            Margin="5,0,5,3" />

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                                x:Name="txtGroupFa"
                                Grid.Column="0"
                                Margin="5"
                                materialDesign:HintAssist.Background="{StaticResource LightBackgroundColor}"
                                materialDesign:HintAssist.FloatingScale="1"
                                materialDesign:HintAssist.Hint="فارسی"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Tag="Persian"
                                TextWrapping="Wrap"
                                LostFocus="AnyTextBox_LostFocus" />
                        <TextBox
                                x:Name="txtGroupEn"
                                Grid.Column="1"
                                Margin="5"
                                materialDesign:HintAssist.Background="{StaticResource LightBackgroundColor}"
                                materialDesign:HintAssist.FloatingScale="1"
                                materialDesign:HintAssist.Hint="English"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Tag="English"
                                TextWrapping="Wrap" 
                                LostFocus="AnyTextBox_LostFocus" />
                    </Grid>

                    <!-- نام دانشکده/واحد -->
                    <TextBlock 
                            x:Name="lblFaculty"
                            Text="نام دانشکده:"
                            FontSize="13"
                            Foreground="#555555"
                            Margin="5,0,5,3" />

                    <Grid x:Name="gridFaculty" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                                x:Name="txtFacultyFa"
                                Grid.Column="0"
                                Margin="5"
                                materialDesign:HintAssist.Background="{StaticResource LightBackgroundColor}"
                                materialDesign:HintAssist.FloatingScale="1"
                                materialDesign:HintAssist.Hint="فارسی"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Tag="Persian"
                                TextWrapping="Wrap" 
                                LostFocus="AnyTextBox_LostFocus" />
                        <TextBox
                                x:Name="txtFacultyEn"
                                Grid.Column="1"
                                Margin="5"
                                materialDesign:HintAssist.Background="{StaticResource LightBackgroundColor}"
                                materialDesign:HintAssist.FloatingScale="1"
                                materialDesign:HintAssist.Hint="English"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Tag="English"
                                TextWrapping="Wrap"
                                LostFocus="AnyTextBox_LostFocus" />
                    </Grid>

                    <!-- نام دانشگاه -->
                    <TextBlock 
                            x:Name="lblUniversity"
                            Text="نام دانشگاه:"
                            FontSize="13"
                            Foreground="#555555"
                            Margin="5,0,5,3" />

                    <Grid x:Name="gridUniversity" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                                x:Name="txtUniversityFa"
                                Grid.Column="0"
                                Margin="5"
                                materialDesign:HintAssist.Background="{StaticResource LightBackgroundColor}"
                                materialDesign:HintAssist.FloatingScale="1"
                                materialDesign:HintAssist.Hint="فارسی"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Tag="Persian"
                                TextWrapping="Wrap" 
                                LostFocus="AnyTextBox_LostFocus" />
                        <TextBox
                                x:Name="txtUniversityEn"
                                Grid.Column="1"
                                Margin="5"
                                materialDesign:HintAssist.Background="{StaticResource LightBackgroundColor}"
                                materialDesign:HintAssist.FloatingScale="1"
                                materialDesign:HintAssist.Hint="English"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Tag="English"
                                TextWrapping="Wrap"
                                LostFocus="AnyTextBox_LostFocus" />
                    </Grid>

                    <!-- نام شهر -->
                    <TextBlock 
                            Text="نام شهر:"
                            FontSize="13"
                            Foreground="#555555"
                            Margin="5,0,5,3" />

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                                x:Name="txtCityFa"
                                Grid.Column="0"
                                Margin="5"
                                materialDesign:HintAssist.Background="{StaticResource LightBackgroundColor}"
                                materialDesign:HintAssist.FloatingScale="1"
                                materialDesign:HintAssist.Hint="فارسی"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Tag="Persian"
                                TextWrapping="Wrap"
                                LostFocus="AnyTextBox_LostFocus" />
                        <TextBox
                                x:Name="txtCityEn"
                                Grid.Column="1"
                                Margin="5"
                                materialDesign:HintAssist.Background="{StaticResource LightBackgroundColor}"
                                materialDesign:HintAssist.FloatingScale="1"
                                materialDesign:HintAssist.Hint="English"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Tag="English"
                                TextWrapping="Wrap"
                                LostFocus="AnyTextBox_LostFocus" />
                    </Grid>

                    <Separator Style="{StaticResource SectionSeparator}" />

                    <!-- ========================================== -->
                    <!-- بخش ۴: پیش‌نمایش نهایی -->
                    <!-- ========================================== -->

                    <TextBlock 
                            Text="📋 پیش‌نمایش نهایی"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryBackgroundColor}"
                            Margin="5,0,5,10" />

                    <Border Style="{StaticResource PreviewBox}">
                        <StackPanel>
                            <TextBlock 
                                    Text="🇮🇷 فارسی:"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="#2E7D32"
                                    Margin="0,0,0,5" />

                            <TextBlock 
                                    x:Name="txtPreviewFa"
                                    FontSize="14"
                                    Foreground="#333333"
                                    TextWrapping="Wrap"
                                    Margin="0,0,0,10"
                                    Text="لطفاً اطلاعات را کامل کنید..." />

                            <Separator 
                                    Height="1" 
                                    Background="#E0E0E0" 
                                    Margin="0,5,0,10" />

                            <TextBlock 
                                    Text="🇬🇧 English:"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="#1565C0"
                                    Margin="0,0,0,5" />

                            <TextBlock 
                                    x:Name="txtPreviewEn"
                                    FontSize="14"
                                    Foreground="#333333"
                                    TextWrapping="Wrap"
                                    Text="Please complete the information..." />
                        </StackPanel>
                    </Border>

                    <!-- ========================================== -->
                    <!-- بخش ۵: دکمه افزودن به لیست -->
                    <!-- ========================================== -->

                    <Button
                            x:Name="btnAddToList"
                            Height="40"
                            Margin="5,0,5,15"
                            materialDesign:ButtonAssist.CornerRadius="5"
                            Background="{StaticResource PrimaryBackgroundColor}"
                            Content="➕ افزودن به لیست"
                            FontWeight="Bold"
                            Foreground="White"
                            Cursor="Hand"
                            IsEnabled="False"
                            Click="btnAddToList_Click" />

                    <!-- ========================================== -->
                    <!-- بخش ۶: لیست اطلاعات -->
                    <!-- ========================================== -->

                    <TextBlock 
                            Text="📋 لیست اطلاعات"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryBackgroundColor}"
                            Margin="5,0,5,10" />

                    <DataGrid
                            x:Name="dgInfoList"
                            Margin="5"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserReorderColumns="False"
                            CanUserResizeColumns="True"
                            CanUserSortColumns="True"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            MaxHeight="150"
                            MinHeight="50"
                            GridLinesVisibility="Horizontal"
                            AlternatingRowBackground="#F5F5F5"
                            RowHeight="35"
                            FontSize="13"
                            BorderBrush="#DDDDDD"
                            BorderThickness="1"
                            Background="White">

                        <DataGrid.Columns>
                            <!-- ستون ترکیب -->
                            <DataGridTextColumn 
                                    Binding="{Binding Index}" 
                                    Header="ترتیب" 
                                    Width="Auto" 
                                    MinWidth="50" />

                            <!-- ستون نام نویسنده -->
                            <DataGridTextColumn 
                                    Binding="{Binding AuthorName}" 
                                    Header="نام نویسنده" 
                                    Width="2*" />

                            <!-- ستون وابستگی علمی (فارسی) -->
                            <DataGridTextColumn 
                                    Binding="{Binding AffiliationFa}" 
                                    Header="وابستگی علمی" 
                                    Width="3*" />

                            <!-- ستون وابستگی علمی (انگلیسی) -->
                            <DataGridTextColumn 
                                    Binding="{Binding AffiliationEn}" 
                                    Header="Affiliation" 
                                    Width="3*" />

                            <!-- ستون عملیات - حذف -->
                            <DataGridTemplateColumn Header="عملیات" Width="Auto" MinWidth="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button 
                                                Content="✕" 
                                                Width="25" 
                                                Height="25" 
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Background="#FF4444" 
                                                Foreground="White"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                ToolTip="حذف"
                                                Click="btnDeleteItem_Click"
                                                Tag="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- وضعیت -->
                    <TextBlock x:Name="lblStatus" FontSize="12" Foreground="#FF9800" Margin="5,5,5,0">
                        ⚠️ لطفاً تمام فیلدها را تکمیل کنید
                    </TextBlock>

                </StackPanel>
            </ScrollViewer>

            <!-- دکمه‌های جلو و عقب -->
            <Grid x:Name="gridTransitionButtons" Grid.Row="1" Margin="10,0,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                        x:Name="btnBackward"
                        Grid.Column="0"
                        Height="42"
                        Margin="0,0,10,0"
                        VerticalAlignment="Bottom"
                        materialDesign:ButtonAssist.CornerRadius="6"
                        Command="{x:Static materialDesign:Transitioner.MovePreviousCommand}"
                        Content="قبلی"
                        FontSize="14"
                        Foreground="{StaticResource LightButtonTextColor}"
                        />

                <Button
                        x:Name="btnForward"
                        Grid.Column="1"
                        Height="42"
                        Margin="10,0,0,0"
                        VerticalAlignment="Bottom"
                        materialDesign:ButtonAssist.CornerRadius="6"
                        Content="ایجاد مقاله"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="{StaticResource LightButtonTextColor}"
                        IsEnabled="False"
                        Click="btnCreateDocument_Click" />

            </Grid>

        </Grid>
    </Border>
</UserControl>