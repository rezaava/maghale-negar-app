<UserControl
        x:Class="MaghaleNegar.Forms.MaghaleNegarManager.CreateDocument.CreateDocumentSlide3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DesignHeight="600"
        d:DesignWidth="800"
        FlowDirection="RightToLeft"
        FontFamily="Vazirmatn"
        mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MaghaleNegar;component/Forms/Styles/MainDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- استایل برای خط جداکننده -->
            <Style x:Key="SectionSeparator" TargetType="Separator">
                <Setter Property="Height" Value="2"/>
                <Setter Property="Margin" Value="0,10,0,15"/>
                <Setter Property="Background" Value="{StaticResource PrimaryBackgroundColor}"/>
                <Setter Property="Opacity" Value="0.3"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="White" CornerRadius="0,0,10,10">
        <Grid x:Name="gridMain">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer
                    x:Name="scrollContent"
                    Grid.Row="0"
                    Margin="0,10,0,0"
                    VerticalScrollBarVisibility="Auto">

                <StackPanel
                        x:Name="stackContent"
                        Margin="20,0,20,20"
                        Orientation="Vertical">

                    <!-- ========================================== -->
                    <!-- بخش ۱: اطلاعات مقاله -->
                    <!-- ========================================== -->

                    <!-- عنوان بخش -->
                    <TextBlock 
                            Text="📄 اطلاعات مقاله"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryBackgroundColor}"
                            Margin="5,0,5,10" />

                    <!-- نام نشریه -->
                    
                                    <ComboBox
                            x:Name="cmbJournalName"
                            Margin="5,0,5,15"
                            materialDesign:HintAssist.Background="{StaticResource LightBackgroundColor}"
                            materialDesign:HintAssist.FloatingScale="1"
                            materialDesign:HintAssist.Hint="انتخاب نشریه"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            SelectedIndex="0">  
                            <ComboBoxItem Content="نشریه علمی ابتکار و خلاقیت در علوم انسانی" />
                    </ComboBox>

                    <!-- نام مقاله -->
                    <Grid x:Name="gridFieldOfStudy" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                                Name="txtBoxFieldOfStudy"
                                Grid.Column="0"
                                Margin="5"
                                materialDesign:HintAssist.Background="{StaticResource LightBackgroundColor}"
                                materialDesign:HintAssist.FloatingScale="1"
                                materialDesign:HintAssist.Hint="نام مقاله"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Tag="Persian"
                                TextWrapping="Wrap" />
                        <TextBox
                                Name="txtBoxFieldOfStudyEn"
                                Grid.Column="1"
                                Margin="5"
                                materialDesign:HintAssist.Background="{StaticResource LightBackgroundColor}"
                                materialDesign:HintAssist.FloatingScale="1"
                                materialDesign:HintAssist.Hint="نام مقاله (انگلیسی)"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Tag="English"
                                TextWrapping="Wrap" />
                    </Grid>

                    <!-- خط جداکننده بین بخش مقاله و نویسنده -->
                    <Separator Style="{StaticResource SectionSeparator}" />

                    <!-- ========================================== -->
                    <!-- بخش ۲: اطلاعات نویسنده -->
                    <!-- ========================================== -->

                    <!-- عنوان بخش -->
                    <TextBlock 
                            Text="👤 اطلاعات نویسنده"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryBackgroundColor}"
                            Margin="5,0,5,10" />

                    <!-- نام نویسنده -->
                    <Grid x:Name="gridAreaOfStudy" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                                Name="txtBoxAreaOfStudy"
                                Grid.Column="0"
                                Margin="5"
                                materialDesign:HintAssist.Background="{StaticResource LightBackgroundColor}"
                                materialDesign:HintAssist.FloatingScale="1"
                                materialDesign:HintAssist.Hint="نام نویسنده"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Tag="Persian"
                                TextWrapping="Wrap" />
                        <TextBox
                                Name="txtBoxAreaOfStudyEn"
                                Grid.Column="1"
                                Margin="5"
                                materialDesign:HintAssist.Background="{StaticResource LightBackgroundColor}"
                                materialDesign:HintAssist.FloatingScale="1"
                                materialDesign:HintAssist.Hint="نام نویسنده (انگلیسی)"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Tag="English"
                                TextWrapping="Wrap" />
                    </Grid>

                    <!-- ایمیل -->
                    <Grid x:Name="gridEmail" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                                Name="txtBoxEmail"
                                Grid.Column="0"
                                Margin="5"
                                materialDesign:HintAssist.Background="{StaticResource LightBackgroundColor}"
                                materialDesign:HintAssist.FloatingScale="1"
                                materialDesign:HintAssist.Hint="ایمیل"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Tag="English"
                                TextWrapping="Wrap"
                                IsEnabled="False" />
                    </Grid>

                    <!-- نویسنده مسئول -->
                    <Grid x:Name="gridResponsibleAuthor" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                                Name="chkResponsibleAuthor"
                                Margin="5"
                                Content="نویسنده مسئول"
                                FontSize="14"
                                FlowDirection="RightToLeft" />
                    </Grid>

                    <!-- دکمه‌ها -->
                    <Grid x:Name="gridAddAuthor" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                                x:Name="btnAddAuthor"
                                Grid.Column="0"
                                Height="40"
                                Margin="5"
                                materialDesign:ButtonAssist.CornerRadius="5"
                                Background="{StaticResource PrimaryBackgroundColor}"
                                Content="➕ افزودن به لیست نویسندگان"
                                FontWeight="Bold"
                                Foreground="White"
                                Cursor="Hand"
                                Click="btnAddAuthor_Click" />

                        <!-- دکمه انصراف از ویرایش -->
                        <Button
                                x:Name="btnCancelEdit"
                                Grid.Column="1"
                                Height="40"
                                Margin="5"
                                materialDesign:ButtonAssist.CornerRadius="5"
                                Background="#FF9800"
                                Content="❌ انصراف از ویرایش"
                                FontWeight="Bold"
                                Foreground="White"
                                Cursor="Hand"
                                Visibility="Collapsed"
                                Click="btnCancelEdit_Click" />
                    </Grid>

                    
                    <!-- ========================================== -->
                    <!-- بخش ۳: لیست نویسندگان -->
                    <!-- ========================================== -->

                    <!-- عنوان بخش با شمارنده نویسندگان -->
                    <TextBlock 
                            Text="📋 لیست نویسندگان"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryBackgroundColor}"
                            Margin="5,0,5,10" />

                    <!-- DataGrid نویسندگان -->
                    <Grid x:Name="gridAuthors" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DataGrid
                                x:Name="dgAuthors"
                                Margin="5"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                CanUserDeleteRows="False"
                                CanUserReorderColumns="False"
                                CanUserResizeColumns="True"
                                CanUserSortColumns="True"
                                HeadersVisibility="Column"
                                IsReadOnly="True"
                                MaxHeight="200"
                                MinHeight="80"
                                GridLinesVisibility="Horizontal"
                                AlternatingRowBackground="#F5F5F5"
                                RowHeight="35"
                                FontSize="13"
                                BorderBrush="#DDDDDD"
                                BorderThickness="1"
                                Background="White">

                            <DataGrid.Columns>
                                <!-- ستون نام نویسنده (فارسی) -->
                                <DataGridTextColumn 
                                        Binding="{Binding Name}" 
                                        Header="نام نویسنده" 
                                        Width="2*" />

                                <!-- ستون نام نویسنده (انگلیسی) -->
                                <DataGridTextColumn 
                                        Binding="{Binding NameEn}" 
                                        Header="نام نویسنده (انگلیسی)" 
                                        Width="2*" />

                                <!-- ستون ایمیل -->
                                <DataGridTextColumn 
                                        Binding="{Binding Email}" 
                                        Header="ایمیل" 
                                        Width="2*" />

                                <!-- ستون نویسنده مسئول -->
                                <DataGridCheckBoxColumn 
                                        Binding="{Binding IsResponsible}" 
                                        Header="نویسنده مسئول" 
                                        Width="Auto" 
                                        MinWidth="100" />

                                <!-- ستون عملیات - ویرایش و حذف -->
                                <DataGridTemplateColumn Header="عملیات" Width="Auto" MinWidth="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <!-- دکمه ویرایش -->
                                                <Button 
                                                        Content="✏️" 
                                                        Width="30" 
                                                        Height="30" 
                                                        FontSize="14"
                                                        Background="#4CAF50" 
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        ToolTip="ویرایش نویسنده"
                                                        Click="btnEditAuthor_Click"
                                                        Tag="{Binding}"
                                                        Margin="0,0,3,0"
                                                        IsEnabled="{Binding IsEditingMode, FallbackValue=True}" />

                                                <!-- دکمه حذف -->
                                                <Button 
                                                        Content="✕" 
                                                        Width="30" 
                                                        Height="30" 
                                                        FontSize="14"
                                                        FontWeight="Bold"
                                                        Background="#FF4444" 
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        ToolTip="حذف نویسنده"
                                                        Click="btnDeleteAuthor_Click"
                                                        Tag="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <!-- دکمه‌های جلو و عقب -->
            <Grid x:Name="gridTransitionButtons" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                        x:Name="btnForward"
                        Grid.Column="1"
                        Height="45"
                        Margin="10"
                        VerticalAlignment="Bottom"
                        materialDesign:ButtonAssist.CornerRadius="5"
                        Content="بعدی"
                        Foreground="{StaticResource LightButtonTextColor}"
                        IsEnabled="False" />

            </Grid>

        </Grid>
    </Border>
</UserControl>